<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Libra LMS | My Library</title>

    <style>
        * {
            box-sizing: border-box;
        }

        :root {
            --bg: #080d19;
            --panel: #111a2b;
            --panel-light: #17243a;
            --border: #26364d;
            --text: #eef4ff;
            --muted: #9aabc1;
            --accent: #5eead4;
            --accent-dark: #2dd4bf;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Inter, Arial, sans-serif;
            color: var(--text);
            background:
                radial-gradient(ellipse at 10% 0%, #153343, transparent 35%),
                radial-gradient(ellipse at 100% 30%, #172545, transparent 35%),
                var(--bg);
        }

        button,
        input {
            font: inherit;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button:focus-visible,
        a:focus-visible,
        input:focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: 3px;
        }

        button:disabled {
            cursor: not-allowed;
        }

        /* NAVBAR */

        .navbar {
            min-height: 76px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding: 12px 4%;
            border-bottom: 1px solid var(--border);
            background: rgba(8, 13, 25, 0.96);

            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;

            backdrop-filter: blur(16px);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--accent);
            font-weight: 800;
            font-size: 22px;
            white-space: nowrap;
        }

        .brand-logo {
            display: grid;
            place-items: center;
            width: 42px;
            height: 42px;
            border-radius: 12px;
            color: #06201e;
            background: linear-gradient(135deg, #99f6e4, #0f766e);
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .nav-link {
            color: var(--muted);
            font-size: 13px;
            transition: color 0.2s;
            white-space: nowrap;
        }

        .nav-link:hover,
        .nav-link.active {
            color: var(--accent);
        }

        .mobile-menu-button {
            display: none;
            width: 40px;
            height: 40px;
            place-items: center;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: var(--panel);
            color: var(--text);
            font-size: 21px;
            cursor: pointer;
        }

        /* PROFILE */

        .profile-area {
            position: relative;
            flex-shrink: 0;
        }

        .profile-trigger {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 5px 10px 5px 5px;
            border: 1px solid var(--border);
            border-radius: 40px;
            color: var(--text);
            background: var(--panel);
            cursor: pointer;
            transition: border-color 0.2s;
        }

        .profile-trigger:hover {
            border-color: var(--accent-dark);
        }

        .profile-trigger-name {
            max-width: 130px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: 12px;
        }

        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            overflow: hidden;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            background: linear-gradient(135deg, #99f6e4, #2dd4bf);
            color: #06201e;
            font-weight: 800;
            border: 2px solid #5eead4a0;
        }

        .avatar img {
            display: none;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .avatar.has-photo img {
            display: block;
        }

        .avatar.has-photo .avatar-initial {
            display: none;
        }

        .profile-menu {
            display: none;
            position: absolute;
            top: calc(100% + 12px);
            right: 0;
            width: min(320px, calc(100vw - 24px));
            padding: 18px;
            background: #111b2e;
            border: 1px solid #33445c;
            border-radius: 16px;
            box-shadow: 0 20px 60px #0009;
        }

        .profile-menu.open {
            display: block;
            animation: menu-in 0.18s ease-out;
        }

        @keyframes menu-in {
            from {
                opacity: 0;
                transform: translateY(-5px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .profile-heading {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--border);
            overflow-wrap: anywhere;
        }

        .profile-heading strong,
        .profile-heading small {
            display: block;
        }

        .profile-heading strong {
            margin-bottom: 5px;
        }

        .profile-heading small {
            color: var(--muted);
            font-size: 12px;
        }

        .file-input {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        .menu-button,
        .profile-menu-link {
            display: block;
            width: 100%;
            padding: 12px;
            margin-top: 12px;
            border: 1px solid var(--border);
            border-radius: 10px;
            cursor: pointer;
            background: var(--panel-light);
            color: var(--text);
            text-align: center;
            font-size: 13px;
            font-weight: 700;
            transition: filter 0.2s;
        }

        .menu-button:hover {
            filter: brightness(1.15);
        }

        .upload-button {
            background: var(--accent-dark);
            color: #06201e;
            border-color: transparent;
        }

        .logout-button {
            background: #451f2b;
            color: #fecaca;
        }

        .profile-menu-link {
            color: var(--muted);
            font-weight: 400;
        }

        .profile-menu-link:hover {
            color: var(--accent);
            border-color: var(--accent-dark);
        }

        /* MAIN AREA */

        .book-area {
            width: min(1200px, 94%);
            margin: 104px auto 20px;
        }

        .book-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 18px;
        }

        .book-heading h1 {
            margin: 0;
            font-size: clamp(21px, 3vw, 30px);
        }

        .book-heading p {
            color: var(--muted);
            margin: 7px 0 0;
            font-size: 13px;
            line-height: 1.7;
        }

        .page-counter {
            color: var(--accent);
            font-size: 12px;
            white-space: nowrap;
        }

        /* BOOK */

        .book {
            position: relative;
            width: 100%;
            height: min(650px, calc(100vh - 240px));
            min-height: 460px;
            perspective: 2200px;
            background: #101a29;
            border: 1px solid #34445a;
            border-radius: 14px;
            box-shadow: 0 25px 80px #0006;
            overflow: hidden;
        }

        .book-spread {
            position: relative;
            z-index: 1;
            width: 100%;
            height: 100%;
        }

        .spread-content {
            display: none;
            grid-template-columns: 1fr 1fr;
            width: 100%;
            height: 100%;
            min-height: 0;
        }

        .spread-content.active {
            display: grid;
        }

        .book-page {
            position: relative;
            min-width: 0;
            min-height: 0;
            overflow-y: auto;
            padding: clamp(20px, 3.5vw, 45px);
            background: linear-gradient(135deg, #142236, #0c1422);
            scrollbar-width: thin;
            scrollbar-color: var(--border) transparent;
        }

        .book-page.left-page {
            border-right: 1px solid #34445a;
            box-shadow: inset -12px 0 20px -20px #000;
        }

        .book-page.right-page {
            background: linear-gradient(225deg, #17263a, #0d1625);
            box-shadow: inset 12px 0 20px -20px #000;
        }

        .book-page::before {
            content: "";
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            width: 3px;
            background: linear-gradient(transparent, #5eead444, transparent);
            pointer-events: none;
        }

        .book-page h2 {
            font-size: clamp(20px, 2.5vw, 28px);
            margin: 12px 0;
            letter-spacing: -0.5px;
            line-height: 1.3;
            overflow-wrap: anywhere;
        }

        .book-page h3 {
            margin-top: 0;
        }

        .book-page p {
            color: #b7c8d8;
            font-size: 13px;
            line-height: 1.9;
        }

        .eyebrow {
            color: var(--accent);
            text-transform: uppercase;
            font-size: 10px;
            letter-spacing: 2px;
            font-weight: 800;
        }

        .welcome-title {
            font-size: clamp(29px, 4vw, 46px) !important;
            line-height: 1.12;
        }

        .big-icon {
            font-size: 54px;
            margin: 25px 0;
        }

        .feature-icon {
            display: grid;
            place-items: center;
            width: 44px;
            height: 44px;
            margin-bottom: 12px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: #5eead413;
            font-size: 22px;
        }

        /* BUTTONS */

        .button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px 16px;
            margin: 8px 5px 0 0;
            border: 1px solid #ffffff20;
            border-radius: 10px;
            background: #ffffff08;
            color: var(--text);
            font-size: 12px;
            font-weight: 800;
            cursor: pointer;
            transition: filter 0.2s, transform 0.2s;
        }

        .button-primary {
            color: #06201e;
            background: var(--accent-dark);
            border-color: transparent;
        }

        .button:hover {
            filter: brightness(1.12);
            transform: translateY(-1px);
        }

        /* STATISTICS */

        .stat-card {
            margin: 15px 0;
            padding: 16px;
            border: 1px solid var(--border);
            border-radius: 13px;
            background: #ffffff05;
        }

        .stat-card small {
            color: var(--muted);
            font-size: 11px;
        }

        .stat-number {
            display: block;
            margin: 8px 0;
            color: var(--accent);
            font-size: 31px;
            font-weight: 800;
        }

        .stat-card p {
            margin: 0;
        }

        /* BORROWING TABLE */

        .table-wrap {
            overflow-x: auto;
            border: 1px solid var(--border);
            border-radius: 12px;
        }

        .activity-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        .activity-table th {
            padding: 12px 10px;
            background: #ffffff05;
            color: var(--muted);
            font-size: 9px;
            letter-spacing: 0.7px;
        }

        .activity-table td {
            padding: 13px 10px;
            border-top: 1px solid var(--border);
            font-size: 11px;
            overflow-wrap: anywhere;
        }

        .status {
            display: inline-block;
            padding: 5px 8px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
            white-space: nowrap;
        }

        .status-returned {
            color: #86efac;
            background: #14532d55;
        }

        .status-borrowed {
            color: #7dd3fc;
            background: #0c4a6e55;
        }

        .status-overdue {
            color: #fda4af;
            background: #88133755;
        }

        .empty-state {
            text-align: center;
            color: var(--muted);
            padding: 22px 10px !important;
            line-height: 1.8;
        }

        .empty-state a {
            color: var(--accent);
        }

        /* BOOK CONTROLS */

        .book-controls {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            gap: 18px;
            margin: 20px 0;
        }

        .page-button {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 13px 20px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: var(--panel);
            color: var(--text);
            cursor: pointer;
            font-size: 13px;
            font-weight: 800;
            transition: background 0.2s, transform 0.2s;
        }

        .page-button:hover:not(:disabled) {
            background: #17413f;
            transform: translateY(-2px);
        }

        .page-button:disabled {
            opacity: 0.35;
        }

        .page-dots {
            display: flex;
            gap: 8px;
        }

        .page-dot {
            width: 9px;
            height: 9px;
            padding: 0;
            border: none;
            border-radius: 50%;
            background: #526176;
            cursor: pointer;
        }

        .page-dot.active {
            background: var(--accent);
            transform: scale(1.2);
        }

        /* PAGE-TURN ANIMATION */

        .turn-sheet {
            position: absolute;
            z-index: 5;
            top: 0;
            bottom: 0;
            width: 50%;
            display: none;
            pointer-events: none;
            background: linear-gradient(90deg, #0b1423, #1d3045, #0b1423);
            transform-style: preserve-3d;
            backface-visibility: hidden;
            box-shadow: 0 0 30px #0004;
        }

        .turn-sheet.turn-next {
            display: block;
            right: 0;
            transform-origin: left center;
            animation: turn-next 0.55s ease-in-out forwards;
        }

        .turn-sheet.turn-prev {
            display: block;
            left: 0;
            transform-origin: right center;
            animation: turn-prev 0.55s ease-in-out forwards;
        }

        @keyframes turn-next {
            from {
                transform: rotateY(0);
            }

            to {
                transform: rotateY(-180deg);
            }
        }

        @keyframes turn-prev {
            from {
                transform: rotateY(0);
            }

            to {
                transform: rotateY(180deg);
            }
        }

        /* FEEDBACK */

        .feedback {
            margin-bottom: 15px;
            padding: 12px;
            border-radius: 10px;
            font-size: 13px;
            line-height: 1.6;
        }

        .feedback.success {
            color: #a7f3d0;
            background: #064e3b66;
            border: 1px solid #047857;
        }

        .feedback.error {
            color: #fecaca;
            background: #7f1d1d66;
            border: 1px solid #b91c1c;
        }

        footer {
            padding: 20px;
            text-align: center;
            color: var(--muted);
            font-size: 11px;
            line-height: 1.8;
            border-top: 1px solid var(--border);
        }

        footer strong {
            color: var(--accent);
            font-size: 15px;
        }

        /* MOBILE */

        @media (max-width: 850px) {
            .navbar {
                flex-wrap: wrap;
                gap: 12px;
            }

            .mobile-menu-button {
                display: grid;
                margin-left: auto;
            }

            .nav-right {
                display: none;
                width: 100%;
                align-items: stretch;
                flex-direction: column;
                gap: 0;
                padding: 12px 0 4px;
            }

            .nav-right.mobile-open {
                display: flex;
            }

            .nav-link {
                display: block;
                padding: 12px;
                border-radius: 8px;
            }

            .nav-link:hover {
                background: #ffffff08;
            }

            .profile-area {
                width: 100%;
                margin-top: 8px;
            }

            .profile-trigger {
                width: 100%;
                justify-content: flex-start;
            }

            .profile-trigger-name {
                max-width: none;
                flex: 1;
                text-align: left;
            }

            .profile-menu {
                position: relative;
                top: 8px;
                width: 100%;
                margin-bottom: 8px;
            }

            .book {
                height: 570px;
                min-height: 420px;
            }

            .book-spread {
                display: block;
            }

            .spread-content {
                display: none;
                grid-template-columns: 1fr;
                height: 100%;
            }

            .spread-content.active {
                display: grid;
            }

            .book-page {
                display: none;
                width: 100%;
                height: 100%;
                border-right: none !important;
                padding: 25px;
            }

            .spread-content.active .book-page.current-mobile {
                display: block;
            }

            .turn-sheet {
                display: none !important;
            }

            .book-controls {
                gap: 12px;
            }

            .page-button {
                padding: 12px;
                font-size: 11px;
            }

            .book-heading {
                align-items: flex-start;
            }
        }

        @media (max-width: 480px) {
            .brand {
                font-size: 19px;
            }

            .book-area {
                width: 94%;
                margin-top: 20px;
            }

            .book {
                height: 540px;
                min-height: 420px;
            }

            .book-page {
                padding: 22px;
            }

            .book-heading {
                gap: 8px;
            }

            .book-heading p {
                max-width: 230px;
            }

            .page-counter {
                font-size: 10px;
            }

            .book-controls {
                gap: 8px;
            }

            .page-button {
                padding: 10px;
            }

            .page-dots {
                gap: 6px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
        }
        
    </style>
</head>

<body>

<header class="navbar">

    <a th:href="@{/}" class="brand">
        <span class="brand-logo">L</span>
        <span>Libra LMS</span>
    </a>

    <button type="button"
            class="mobile-menu-button"
            id="mobile-menu-button"
            aria-label="Toggle navigation"
            aria-expanded="false"
            aria-controls="nav-right">
        ☰
    </button>

    <nav class="nav-right" id="nav-right" aria-label="Main navigation">

        <a class="nav-link active" th:href="@{/user/dashboard}">
            Dashboard
        </a>

        <a class="nav-link" th:href="@{/}">
            Home
        </a>

        <a class="nav-link" th:href="@{/books}">
            Explore Books
        </a>

        <a class="nav-link" th:href="@{/user/borrowings}">
            My Borrowings
        </a>

        <div class="profile-area">

            <button type="button"
                    class="profile-trigger"
                    id="profile-trigger"
                    aria-expanded="false"
                    aria-controls="profile-menu">

                <span class="avatar" id="navbar-avatar">
                    <img th:src="@{/profile/photo}"
                         alt="Profile picture">
                    <span class="avatar-initial" id="navbar-initial">U</span>
                </span>

                <span class="profile-trigger-name"
                      th:text="${user.fullName}">
                    User
                </span>

                <span aria-hidden="true">⌄</span>
            </button>

            <div class="profile-menu" id="profile-menu">

                <div class="profile-heading">

                    <span class="avatar" id="menu-avatar">
                        <img th:src="@{/profile/photo}"
                             alt="Profile picture">
                        <span class="avatar-initial" id="menu-initial">U</span>
                    </span>

                    <div>
                        <strong th:text="${user.fullName}">User</strong>
                        <small th:text="${user.email}">user@example.com</small>
                    </div>

                </div>

                <form id="profile-photo-form"
                      th:action="@{/profile/photo}"
                      method="post"
                      enctype="multipart/form-data">

                    <input type="hidden"
                           th:name="${_csrf.parameterName}"
                           th:value="${_csrf.token}">

                    <input class="file-input"
                           type="file"
                           id="profile-photo"
                           name="photo"
                           accept="image/png,image/jpeg"
                           aria-label="Choose profile picture">

                    <button type="button"
                            class="menu-button upload-button"
                            id="change-photo-button">
                        📷 Change Profile Picture
                    </button>

                </form>

                <a class="profile-menu-link"
                   th:href="@{/user/dashboard}">
                    🏠 Back to Dashboard
                </a>

                <a class="profile-menu-link"
                   th:href="@{/books}">
                    📚 Explore Books
                </a>

                <a class="profile-menu-link"
                   th:href="@{/user/borrowings}">
                    📋 View My Borrowings
                </a>

                <form th:action="@{/logout}" method="post">

                    <input type="hidden"
                           th:name="${_csrf.parameterName}"
                           th:value="${_csrf.token}">

                    <button type="submit"
                            class="menu-button logout-button">
                        ↪ Log Out
                    </button>

                </form>

            </div>
        </div>
    </nav>
</header>

<main class="book-area">

    <div class="book-heading">
        <div>
            <h1>Your Personal Library</h1>
            <p>Turn the pages to explore your Libra account.</p>
        </div>

        <span class="page-counter" id="page-counter">
            Spread 1 of 3
        </span>
    </div>

    <div th:if="${profileSuccess}"
         class="feedback success"
         th:text="${profileSuccess}"
         role="status"></div>

    <div th:if="${profileError}"
         class="feedback error"
         th:text="${profileError}"
         role="alert"></div>

    <div class="book" id="book">

        <div class="turn-sheet" id="turn-sheet"></div>

        <div class="book-spread">

            <!-- SPREAD 1: WELCOME AND STATISTICS -->

            <section class="spread-content active" data-spread="0">

                <article class="book-page left-page current-mobile">

                    <span class="eyebrow">Welcome to Libra</span>

                    <h2 class="welcome-title">
                        Your next great discovery awaits.
                    </h2>

                    <div class="big-icon">📚</div>

                    <p>
                        Your library, your learning, your journey.
                        Discover books, track your borrowing history,
                        and build your own reading adventure.
                    </p>

                    <a class="button button-primary" th:href="@{/books}">
                        Explore Books →
                    </a>

                    <p style="margin-top: 35px">
                        <small>LIBRA LMS · YOUR DIGITAL LIBRARY</small>
                    </p>

                </article>

                <article class="book-page right-page current-mobile">

                    <span class="eyebrow">Your account</span>

                    <h2>
                        Welcome back,<br>
                        <span th:text="${user.fullName}">Reader</span> ✨
                    </h2>

                    <p>Here's a quick look at your reading activity.</p>

                    <div class="stat-card">
                        <small>Currently Borrowed</small>

                        <strong class="stat-number"
                                th:text="${activeBorrowings}">0</strong>

                        <p>Books not yet returned</p>
                    </div>

                    <div class="stat-card">
                        <small>Overdue Books</small>

                        <strong class="stat-number"
                                th:text="${overdueBorrowings}">0</strong>

                        <p>Books past their due date</p>
                    </div>

                    <div class="stat-card">
                        <small>Total Borrowing Records</small>

                        <strong class="stat-number"
                                th:text="${totalBorrowingRecords}">0</strong>
                    </div>

                </article>

            </section>

            <!-- SPREAD 2: BORROWING HISTORY -->

            <section class="spread-content" data-spread="1">

                <article class="book-page left-page">

                    <span class="eyebrow">Your history</span>

                    <h2>Recent Borrowings</h2>

                    <p>
                        Review your recent transactions and keep track
                        of your return dates.
                    </p>

                    <div class="stat-card">
                        <div class="big-icon">📖</div>

                        <h3>Keep reading</h3>

                        <p>
                            Return books on time and discover something
                            new whenever you visit the catalogue.
                        </p>
                    </div>

                    <a class="button button-primary"
                       th:href="@{/user/borrowings}">
                        View All Records →
                    </a>

                </article>

                <article class="book-page right-page">

                    <span class="eyebrow">Transaction history</span>

                    <h2>Recent Activity</h2>

                    <div class="table-wrap">

                        <table class="activity-table">

                            <thead>
                                <tr>
                                    <th>BOOK</th>
                                    <th>BORROWED</th>
                                    <th>DUE DATE</th>
                                    <th>STATUS</th>
                                </tr>
                            </thead>

                            <tbody>

                                <tr th:each="record : ${recentBorrowings}">

                                    <td th:text="${record.book.title}">
                                        Book
                                    </td>

                                    <td th:text="${record.borrowDate}">
                                        Date
                                    </td>

                                    <td th:text="${record.dueDate}">
                                        Date
                                    </td>

                                    <td>

                                        <span th:if="${record.status == 'RETURNED'}"
                                              class="status status-returned">
                                            Returned
                                        </span>

                                        <span th:if="${record.status == 'BORROWED' and record.dueDate != null and record.dueDate.isBefore(T(java.time.LocalDate).now())}"
                                              class="status status-overdue">
                                            Overdue
                                        </span>

                                        <span th:if="${record.status == 'BORROWED' and (record.dueDate == null or !record.dueDate.isBefore(T(java.time.LocalDate).now()))}"
                                              class="status status-borrowed">
                                            Borrowed
                                        </span>

                                    </td>

                                </tr>

                                <tr th:if="${#lists.isEmpty(recentBorrowings)}">

                                    <td colspan="4" class="empty-state">
                                        No borrowing records yet.
                                        <br>
                                        <a th:href="@{/books}">
                                            Explore books →
                                        </a>
                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                    <a class="button" th:href="@{/user/borrowings}">
                        View All Borrowings →
                    </a>

                </article>

            </section>

            <!-- SPREAD 3: CATALOGUE AND QUICK ACCESS -->

            <section class="spread-content" data-spread="2">

                <article class="book-page left-page">

                    <span class="eyebrow">Discover</span>

                    <h2>Explore the Catalogue</h2>

                    <div class="big-icon">🔎</div>

                    <p>
                        Find your next favourite book. Explore the
                        catalogue and search for books by title,
                        author, ISBN, or category.
                    </p>

                    <a class="button button-primary" th:href="@{/books}">
                        Browse Books →
                    </a>

                    <div class="stat-card">
                        <h3>Reading tip</h3>

                        <p>
                            Set aside a little time every day to learn
                            something new.
                        </p>
                    </div>

                </article>

                <article class="book-page right-page">

                    <span class="eyebrow">Your library</span>

                    <h2>Everything in One Place</h2>

                    <div class="stat-card">

                        <div class="feature-icon">📚</div>

                        <h3>Explore Books</h3>

                        <p>Browse the available library catalogue.</p>

                        <a class="button button-primary" th:href="@{/books}">
                            Open Catalogue →
                        </a>

                    </div>

                    <div class="stat-card">

                        <div class="feature-icon">📋</div>

                        <h3>My Borrowings</h3>

                        <p>Check your borrowing history and due dates.</p>

                        <a class="button" th:href="@{/user/borrowings}">
                            View Borrowings →
                        </a>

                    </div>

                    <div class="stat-card">

                        <h3>💡 Quick tip</h3>

                        <p>
                            Click your profile picture in the top-right
                            corner to upload a new photo or log out.
                        </p>

                    </div>

                </article>

            </section>

        </div>
    </div>

    <!-- BOOK NAVIGATION -->

    <div class="book-controls">

        <button type="button"
                class="page-button"
                id="back-button"
                disabled>
            ← Previous
        </button>

        <div class="page-dots" id="page-dots" aria-label="Book pages">

            <button type="button"
                    class="page-dot active"
                    aria-label="Go to spread 1"
                    aria-current="page"
                    data-page="0"></button>

            <button type="button"
                    class="page-dot"
                    aria-label="Go to spread 2"
                    data-page="1"></button>

            <button type="button"
                    class="page-dot"
                    aria-label="Go to spread 3"
                    data-page="2"></button>

        </div>

        <button type="button"
                class="page-button"
                id="forward-button">
            Next →
        </button>

    </div>

</main>

<footer>
    <strong>Libra LMS</strong>
    <br>
    Your library. Your learning. Your journey.
</footer>

<script>
document.addEventListener("DOMContentLoaded", () => {

    /* BOOK NAVIGATION */

    const spreads = [...document.querySelectorAll(".spread-content")];
    const backButton = document.getElementById("back-button");
    const forwardButton = document.getElementById("forward-button");
    const counter = document.getElementById("page-counter");
    const dots = [...document.querySelectorAll(".page-dot")];
    const turnSheet = document.getElementById("turn-sheet");
    const book = document.getElementById("book");

    let currentSpread = 0;
    let isTurning = false;

    const isMobile = () =>
        window.matchMedia("(max-width: 850px)").matches;

    function renderSpread(index) {

        spreads.forEach((spread, spreadIndex) => {

            spread.classList.toggle("active", spreadIndex === index);

            const pages = spread.querySelectorAll(".book-page");

            pages.forEach((page, pageIndex) => {

                page.classList.toggle(
                    "current-mobile",
                    isMobile() && pageIndex === 0
                );

            });

        });

        counter.textContent =
            `Spread ${index + 1} of ${spreads.length}`;

        backButton.disabled = index === 0;
        forwardButton.disabled = index === spreads.length - 1;

        dots.forEach((dot, dotIndex) => {

            const active = dotIndex === index;

            dot.classList.toggle("active", active);

            if (active) {
                dot.setAttribute("aria-current", "page");
            } else {
                dot.removeAttribute("aria-current");
            }

        });

    }

    function goToSpread(index) {

        if (
            isTurning ||
            index < 0 ||
            index >= spreads.length ||
            index === currentSpread
        ) {
            return;
        }

        isTurning = true;

        if (!isMobile()) {

            const direction =
                index > currentSpread ? "turn-next" : "turn-prev";

            turnSheet.className = "turn-sheet";

            void turnSheet.offsetWidth;

            turnSheet.classList.add(direction);

        }

        window.setTimeout(() => {

            currentSpread = index;

            renderSpread(currentSpread);

            turnSheet.className = "turn-sheet";

            isTurning = false;

        }, isMobile() ? 0 : 550);

    }

    backButton.addEventListener("click", () => {
        goToSpread(currentSpread - 1);
    });

    forwardButton.addEventListener("click", () => {
        goToSpread(currentSpread + 1);
    });

    dots.forEach(dot => {

        dot.addEventListener("click", () => {
            goToSpread(Number(dot.dataset.page));
        });

    });

    document.addEventListener("keydown", event => {

        if (event.altKey || event.ctrlKey || event.metaKey) {
            return;
        }

        const tag = event.target.tagName;

        if (
            ["INPUT", "TEXTAREA", "SELECT", "BUTTON"].includes(tag) ||
            event.target.isContentEditable
        ) {
            return;
        }

        if (event.key === "ArrowRight") {
            goToSpread(currentSpread + 1);
        }

        if (event.key === "ArrowLeft") {
            goToSpread(currentSpread - 1);
        }

    });

    /* TOUCH SWIPE */

    let touchStartX = 0;
    let touchStartY = 0;

    book.addEventListener("touchstart", event => {

        touchStartX = event.changedTouches[0].screenX;
        touchStartY = event.changedTouches[0].screenY;

    }, { passive: true });

    book.addEventListener("touchend", event => {

        const deltaX =
            event.changedTouches[0].screenX - touchStartX;

        const deltaY =
            event.changedTouches[0].screenY - touchStartY;

        if (Math.abs(deltaX) < 60 ||
            Math.abs(deltaX) < Math.abs(deltaY)) {
            return;
        }

        if (deltaX < 0) {
            goToSpread(currentSpread + 1);
        } else {
            goToSpread(currentSpread - 1);
        }

    }, { passive: true });

    window.addEventListener("resize", () => {
        renderSpread(currentSpread);
    });

    renderSpread(currentSpread);

    /* MOBILE MENU */

    const mobileMenuButton =
        document.getElementById("mobile-menu-button");

    const navRight = document.getElementById("nav-right");

    mobileMenuButton.addEventListener("click", event => {

        event.stopPropagation();

        const isOpen = navRight.classList.toggle("mobile-open");

        mobileMenuButton.setAttribute(
            "aria-expanded",
            String(isOpen)
        );

        mobileMenuButton.textContent = isOpen ? "✕" : "☰";

    });

    /* PROFILE DROPDOWN */

    const trigger = document.getElementById("profile-trigger");
    const menu = document.getElementById("profile-menu");

    function closeProfileMenu() {

        menu.classList.remove("open");

        trigger.setAttribute("aria-expanded", "false");

    }

    trigger.addEventListener("click", event => {

        event.stopPropagation();

        const isOpen = menu.classList.toggle("open");

        trigger.setAttribute("aria-expanded", String(isOpen));

    });

    document.addEventListener("click", event => {

        if (!menu.contains(event.target) &&
            !trigger.contains(event.target)) {
            closeProfileMenu();
        }

    });

    document.addEventListener("keydown", event => {

        if (event.key === "Escape") {

            closeProfileMenu();

            navRight.classList.remove("mobile-open");

            mobileMenuButton.setAttribute("aria-expanded", "false");

            mobileMenuButton.textContent = "☰";

        }

    });

    /* PROFILE PHOTO UPLOAD */

    const photoInput = document.getElementById("profile-photo");
    const photoForm = document.getElementById("profile-photo-form");
    const changePhotoButton =
        document.getElementById("change-photo-button");

    changePhotoButton.addEventListener("click", () => {
        photoInput.click();
    });

    photoInput.addEventListener("change", () => {

        if (!photoInput.files || photoInput.files.length === 0) {
            return;
        }

        const file = photoInput.files[0];

        const allowedTypes = ["image/jpeg", "image/png"];

        if (!allowedTypes.includes(file.type)) {

            alert("Please select a PNG or JPEG image.");
            photoInput.value = "";
            return;

        }

        if (file.size > 3 * 1024 * 1024) {

            alert("Your profile picture must be smaller than 3 MB.");
            photoInput.value = "";
            return;

        }

        if (typeof photoForm.requestSubmit === "function") {
            photoForm.requestSubmit();
        } else {
            photoForm.submit();
        }

    });

    /* PROFILE INITIALS */

    const nameElement =
        document.querySelector(".profile-heading strong");

    const fullName = nameElement
        ? nameElement.textContent.trim()
        : "";

    const initial = fullName
        ? fullName.charAt(0).toUpperCase()
        : "U";

    document.getElementById("navbar-initial").textContent = initial;
    document.getElementById("menu-initial").textContent = initial;

    /* PROFILE PHOTO DISPLAY */

    document.querySelectorAll(".avatar img").forEach(img => {

        const showPhoto = () => {

            if (img.naturalWidth > 0) {
                img.closest(".avatar").classList.add("has-photo");
            }

        };

        img.addEventListener("load", showPhoto);

        img.addEventListener("error", () => {

            img.closest(".avatar").classList.remove("has-photo");

        });

        if (img.complete && img.naturalWidth > 0) {
            showPhoto();
        }

    });

});
</script>

</body>
</html>