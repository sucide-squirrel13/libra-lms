<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<body>

<header class="navbar" th:fragment="navigation">

    <a th:href="@{/}" class="brand">
        <span class="brand-logo">L</span>
        <span>Libra LMS</span>
    </a>

    <button type="button"
            class="mobile-menu-button"
            id="mobile-menu-button"
            aria-label="Toggle navigation"
            aria-expanded="false">
        ☰
    </button>

    <nav class="nav-right" id="nav-right">

        <a class="nav-link" th:href="@{/}">Home</a>

        <a class="nav-link" th:href="@{/user/dashboard}">
            Dashboard
        </a>

        <a class="nav-link" th:href="@{/books}">
            Explore Books
        </a>

        <a class="nav-link" th:href="@{/user/borrowings}">
            My Borrowings
        </a>

        <!-- PROFILE BUTTON -->
        <div class="profile-area">

            <button type="button"
                    class="profile-trigger"
                    id="profile-trigger"
                    aria-expanded="false"
                    aria-controls="profile-menu">

                <span class="avatar" id="navbar-avatar">

                    <img th:src="@{/profile/photo}"
                         alt="Profile picture">

                    <span class="avatar-initial"
                          id="navbar-initial">U</span>

                </span>

                <span class="profile-trigger-name"
                      th:text="${user.fullName}">
                    User
                </span>

                <span aria-hidden="true">⌄</span>

            </button>

            <!-- PROFILE DROPDOWN -->
            <div class="profile-menu" id="profile-menu">

                <div class="profile-heading">

                    <span class="avatar" id="menu-avatar">

                        <img th:src="@{/profile/photo}"
                             alt="Profile picture">

                        <span class="avatar-initial"
                              id="menu-initial">U</span>

                    </span>

                    <div>
                        <strong th:text="${user.fullName}">User</strong>
                        <small th:text="${user.email}">
                            user@example.com
                        </small>
                    </div>

                </div>

                <!-- PHOTO UPLOAD -->
                <form th:action="@{/profile/photo}"
                      method="post"
                      enctype="multipart/form-data"
                      id="profile-photo-form">

                    <input type="hidden"
                           th:name="${_csrf.parameterName}"
                           th:value="${_csrf.token}">

                    <input type="file"
                           name="photo"
                           id="profile-photo"
                           accept="image/png,image/jpeg"
                           hidden>

                    <button type="button"
                            class="menu-button upload-button"
                            id="change-photo-button">
                        📷 Change Profile Picture
                    </button>

                </form>

                <a class="profile-menu-link"
                   th:href="@{/user/dashboard}">
                    🏠 Dashboard
                </a>

                <a class="profile-menu-link"
                   th:href="@{/books}">
                    📚 Explore Books
                </a>

                <a class="profile-menu-link"
                   th:href="@{/user/borrowings}">
                    📋 My Borrowings
                </a>

                <form th:action="@{/logout}" method="post">

                    <input type="hidden"
                           th:name="${_csrf.parameterName}"
                           th:value="${_csrf.token}">

                    <button type="submit"
                            class="menu-button logout-button">
                        ↪ Log Out
                    </button>

                </form>

            </div>

        </div>

    </nav>

    <script>
    document.addEventListener("DOMContentLoaded", function () {

        const trigger = document.getElementById("profile-trigger");
        const menu = document.getElementById("profile-menu");
        const mobileButton = document.getElementById("mobile-menu-button");
        const nav = document.getElementById("nav-right");
        const photoInput = document.getElementById("profile-photo");
        const photoForm = document.getElementById("profile-photo-form");
        const changePhotoButton =
            document.getElementById("change-photo-button");

        // Profile dropdown
        trigger.addEventListener("click", function (event) {

            event.stopPropagation();

            const open = menu.classList.toggle("open");

            trigger.setAttribute("aria-expanded", String(open));

        });

        document.addEventListener("click", function (event) {

            if (!menu.contains(event.target) &&
                !trigger.contains(event.target)) {

                menu.classList.remove("open");
                trigger.setAttribute("aria-expanded", "false");

            }

        });

        // Mobile navigation
        mobileButton.addEventListener("click", function () {

            const open = nav.classList.toggle("mobile-open");

            mobileButton.setAttribute("aria-expanded", String(open));
            mobileButton.textContent = open ? "✕" : "☰";

        });

        nav.querySelectorAll(".nav-link").forEach(function (link) {

            link.addEventListener("click", function () {

                nav.classList.remove("mobile-open");
                mobileButton.setAttribute("aria-expanded", "false");
                mobileButton.textContent = "☰";

            });

        });

        // Open photo picker only after the button is clicked
        changePhotoButton.addEventListener("click", function () {
            photoInput.click();
        });

        // Validate and upload selected photo
        photoInput.addEventListener("change", function () {

            if (!photoInput.files || photoInput.files.length === 0) {
                return;
            }

            const file = photoInput.files[0];

            if (!["image/png", "image/jpeg"].includes(file.type)) {
                alert("Please select a PNG or JPEG image.");
                photoInput.value = "";
                return;
            }

            if (file.size > 3 * 1024 * 1024) {
                alert("The profile picture must be smaller than 3 MB.");
                photoInput.value = "";
                return;
            }

            photoForm.requestSubmit();

        });

        // Initials fallback
        const nameElement =
            document.querySelector(".profile-heading strong");

        const initial = nameElement && nameElement.textContent.trim()
            ? nameElement.textContent.trim().charAt(0).toUpperCase()
            : "U";

        document.getElementById("navbar-initial").textContent = initial;
        document.getElementById("menu-initial").textContent = initial;

        // Load profile pictures
        document.querySelectorAll(".avatar img").forEach(function (img) {

            function showPhoto() {

                if (img.naturalWidth > 0) {
                    img.closest(".avatar").classList.add("has-photo");
                }

            }

            img.addEventListener("load", showPhoto);

            img.addEventListener("error", function () {
                img.closest(".avatar").classList.remove("has-photo");
            });

            if (img.complete && img.naturalWidth > 0) {
                showPhoto();
            }

        });

        // Escape closes the dropdown
        document.addEventListener("keydown", function (event) {

            if (event.key === "Escape") {

                menu.classList.remove("open");
                trigger.setAttribute("aria-expanded", "false");

                nav.classList.remove("mobile-open");
                mobileButton.setAttribute("aria-expanded", "false");
                mobileButton.textContent = "☰";

            }

        });

    });
    </script>

</header>

</body>
</html>